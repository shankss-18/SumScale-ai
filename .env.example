# =============================================================================
# SumScale 2.0 — Environment Variables Template
# =============================================================================
# Copy this file to backend/.env and fill in your values.
# See LOCAL_SETUP.md for step-by-step instructions on getting each key.
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED — Google Gemini API Key
# Get FREE key: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# RECOMMENDED — Groq (Fast text LLM — 14,400 req/day FREE)
# https://console.groq.com — leave empty to use Gemini for text too
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# REQUIRED — MongoDB
# Local (no account):  mongodb://localhost:27017
# Atlas free cloud:    mongodb+srv://<username>:<password>@cluster.mongodb.net
# ---------------------------------------------------------------------------
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=sumscale_local

# ---------------------------------------------------------------------------
# REQUIRED — JWT Secret (auto-generated on setup — do not change after users exist)
# Generate: python -c "import secrets; print(secrets.token_hex(64))"
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=your_very_strong_random_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ---------------------------------------------------------------------------
# REQUIRED — Frontend URL for CORS
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# ---------------------------------------------------------------------------
# EMAIL OTP — Pick ONE provider
# Brevo (easiest, FREE 300/day): https://app.brevo.com/account/register
# Resend (FREE 3,000/mo):        https://resend.com
# Gmail SMTP (App Password):     https://myaccount.google.com/apppasswords
# ---------------------------------------------------------------------------
BREVO_API_KEY=
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com

# ---------------------------------------------------------------------------
# OPTIONAL — Fraud Verification APIs (gracefully skipped if not set)
# ---------------------------------------------------------------------------
GOOGLE_SAFE_BROWSING_KEY=
VIRUSTOTAL_API_KEY=
IPQUALITYSCORE_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL — Google Places API (for "Find Nearby" map feature)
# ---------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL — Twilio SMS Alerts (emergency contact SMS)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------------------
# OPTIONAL — Frontend Demo Login Button
# ---------------------------------------------------------------------------
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
